---
// Footer — full-bleed black inversion, one register of links.
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="footer-inner">
    <ul class="footer-links">
      <li><a href="https://thetatau.org">Theta Tau Central Office</a></li>
      <li><a href="https://umdearborn.edu">University of Michigan-Dearborn</a></li>
      <li><a href="https://www.instagram.com/umdthetatau/">Instagram</a></li>
      <li><a href="https://umdearborn.campuslabs.com/engage/organization/thetatau-ob">Victors Link</a></li>
      <li><a href="mailto:eboard@obthetatau.org">eboard@obthetatau.org</a></li>
    </ul>
    <p class="footer-line">
      Theta Tau, Omicron Beta chapter. University of Michigan-Dearborn.
    </p>
    <p class="footer-copy">© {year} Omicron Beta chapter of Theta Tau</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--tt-black);
    color: var(--tt-white);
    margin-top: var(--sp-8);
  }
  .footer-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--sp-6) var(--gutter);
  }
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--sp-4);
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--sp-4);
    row-gap: var(--sp-1);
    border-bottom: 1px solid var(--tt-ink);
  }
  .footer-links a {
    font-family: var(--font-head);
    font-size: var(--fs-ui);
    font-weight: 500;
    text-decoration: none;
  }
  .footer-links a:hover { text-decoration: underline; }
  .footer-line {
    padding-top: var(--sp-4);
    color: var(--tt-white);
    font-size: var(--fs-ui);
  }
  .footer-copy {
    padding-top: var(--sp-1);
    font-family: var(--font-head);
    font-size: var(--fs-caption);
    color: var(--tt-rule);
  }
</style>
