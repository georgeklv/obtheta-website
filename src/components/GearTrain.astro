<style>
  .train {
    border-top: var(--rule-hairline);
    background: var(--tt-white);
  }
  .train-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--sp-5) var(--gutter) var(--sp-5);
  }
  .train-hint {
    font-family: var(--font-head);
    font-size: var(--fs-ui);
    color: var(--tt-ink);
    max-width: 44ch;
  }
  .train-stage {
    margin-top: var(--sp-4);
    cursor: grab;
    touch-action: pan-y;
  }
  .train-stage.dragging { cursor: grabbing; }
  .train-svg { width: 100%; height: auto; display: block; }
  .train-readout {
    margin-top: var(--sp-3);
    font-family: var(--font-head);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--tt-ink);
    font-variant-numeric: tabular-nums;
  }
  .gs-body  { fill: var(--gear-steel-2); stroke: var(--gear-steel-3); stroke-width: 1.5; }
  .gs-face  { fill: var(--gear-steel-1); }
  .gs-web   { fill: var(--gear-steel-2); }
  .gs-ring  { fill: none; stroke: var(--gear-steel-3); stroke-width: 1.25; opacity: 0.6; }
  .gs-hub   { fill: var(--gear-steel-1); stroke: var(--gear-steel-3); stroke-width: 1.5; }
  .gs-bore  { fill: var(--gear-steel-3); }
  @media (prefers-reduced-motion: reduce) {
    .train-hint, .train-readout { display: none; }
    .train-stage { cursor: default; touch-action: auto; }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stage = document.getElementById('train-stage');
  if (stage && !reduced) {
    const svg = stage.querySelector('svg')!;
    const rpmEl = document.getElementById('train-rpm')!;
    const gears = Array.from(svg.querySelectorAll<SVGGElement>('.tg')).map((el) => ({
      rot: el.querySelector<SVGGElement>('.tg-rot')!,
      el,
      r: Number(el.dataset.r),
      dir: Number(el.dataset.dir),
      phase: Number(el.dataset.phase),
    }));
    const R_DRIVE = gears[2].r;

    let theta = 0;       // drive-wheel angle, degrees
    let vel = 0;         // deg/s
    let dragging: { g: typeof gears[0]; last: number; t: number } | null = null;
    let lastFrame = 0;

    const apply = () => {
      for (const g of gears) {
        const a = g.dir * theta * (R_DRIVE / g.r) + g.phase;
        g.rot.setAttribute('transform', `rotate(${a.toFixed(3)})`);
      }
      rpmEl.textContent = String(Math.abs(Math.round((vel / 360) * 60)));
    };

    const pointerAngle = (e: PointerEvent, el: SVGGElement) => {
      const r = el.getBoundingClientRect();
      return Math.atan2(
        e.clientY - (r.top + r.height / 2),
        e.clientX - (r.left + r.width / 2)
      ) * 180 / Math.PI;
    };
    const norm = (a: number) => ((a + 180) % 360 + 360) % 360 - 180;

    for (const g of gears) {
      g.el.addEventListener('pointerdown', (e) => {
        dragging = { g, last: pointerAngle(e, g.el), t: performance.now() };
        stage.classList.add('dragging');
        g.el.setPointerCapture(e.pointerId);
        vel = 0;
      });
      g.el.addEventListener('pointermove', (e) => {
        if (!dragging || dragging.g !== g) return;
        const now = performance.now();
        const a = pointerAngle(e, g.el);
        const d = norm(a - dragging.last);
        // convert this wheel's rotation into drive-wheel terms
        const dDrive = d * g.dir * (g.r / R_DRIVE);
        theta += dDrive;
        const dt = (now - dragging.t) / 1000;
        if (dt > 0) vel = dDrive / dt;
        dragging.last = a;
        dragging.t = now;
        apply();
      });
      const drop = () => { dragging = null; stage.classList.remove('dragging'); };
      g.el.addEventListener('pointerup', drop);
      g.el.addEventListener('pointercancel', drop);
    }

    stage.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      vel = Math.max(-720, Math.min(720, vel + (e.key === 'ArrowRight' ? 120 : -120)));
    });

    const loop = (t: number) => {
      const dt = lastFrame ? (t - lastFrame) / 1000 : 0;
      lastFrame = t;
      if (!dragging && Math.abs(vel) > 1) {
        theta += vel * dt;
        vel *= Math.exp(-1.1 * dt);
        apply();
      } else if (!dragging && vel !== 0) {
        vel = 0;
        apply();
      }
      requestAnimationFrame(loop);
    };
    apply();
    requestAnimationFrame(loop);
  }
</script>
