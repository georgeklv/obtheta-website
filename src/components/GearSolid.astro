---
// Realistic 24-tooth involute spur gear. The flanks are true involutes of
// the base circle, so the profile is the shape a real hobbed gear has.
// Rotate the .gear-spin group only — the lighting layer is deliberately
// static so the light stays put while the metal turns.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class={className} viewBox="-130 -130 260 260" role="img" aria-hidden="true">
  <defs>
    <radialGradient id="g-face" cx="50%" cy="50%" r="50%">
      <stop offset="0%"   stop-color="#D5DADE"/>
      <stop offset="55%"  stop-color="#AEB4BA"/>
      <stop offset="88%"  stop-color="#868D94"/>
      <stop offset="100%" stop-color="#6E757C"/>
    </radialGradient>
    <radialGradient id="g-web" cx="50%" cy="50%" r="50%">
      <stop offset="0%"   stop-color="#B7BDC3"/>
      <stop offset="70%"  stop-color="#959BA2"/>
      <stop offset="100%" stop-color="#787F86"/>
    </radialGradient>
    <radialGradient id="g-hub" cx="50%" cy="42%" r="58%">
      <stop offset="0%"   stop-color="#E2E6E9"/>
      <stop offset="60%"  stop-color="#B4BAC0"/>
      <stop offset="100%" stop-color="#8B9299"/>
    </radialGradient>
    <radialGradient id="g-hole" cx="50%" cy="35%" r="65%">
      <stop offset="0%"   stop-color="#2B2F34"/>
      <stop offset="70%"  stop-color="#3D4249"/>
      <stop offset="100%" stop-color="#5A6067"/>
    </radialGradient>
    <!-- static directional light -->
    <linearGradient id="g-lit" x1="12%" y1="4%" x2="82%" y2="96%">
      <stop offset="0%"   stop-color="#FFFFFF" stop-opacity="0.55"/>
      <stop offset="34%"  stop-color="#FFFFFF" stop-opacity="0.10"/>
      <stop offset="62%"  stop-color="#000000" stop-opacity="0.06"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0.42"/>
    </linearGradient>
    <radialGradient id="g-spec" cx="30%" cy="22%" r="42%">
      <stop offset="0%"   stop-color="#FFFFFF" stop-opacity="0.62"/>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
    </radialGradient>
    <filter id="g-grain" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" result="n"/>
      <feColorMatrix in="n" type="saturate" values="0"/>
      <feComponentTransfer><feFuncA type="linear" slope="0.13"/></feComponentTransfer>
    </filter>
    <clipPath id="g-clip"><circle r="104.00"/></clipPath>
  </defs>

  <!-- body thickness: static, so the part never looks like it is wobbling -->
  <g class="gear-depth">
    <circle r="88.00" cx="3.5" cy="4.5" fill="#4A5057"/>
  </g>

