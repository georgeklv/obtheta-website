---
import Base from '../layouts/Base.astro';
import Roster from '../components/Roster.astro';
import roster from '../../data/brothers.json';

const brothers = roster.brothers;
const maxRoll = Math.max(...brothers.map((b) => b.roll));
---
<Base
  title="Brothers | Theta Tau Omicron Beta"
  description={`The brothers of the Omicron Beta chapter of Theta Tau at UM-Dearborn: the full chapter roster, rolls OB 1 to OB ${maxRoll}.`}
>
  <div class="page container">
    <h1 class="page-title">Brothers</h1>

    <section data-reveal aria-labelledby="roster-title">
      <h2 id="roster-title" class="section-title">Brother roster</h2>
      <Roster brothers={brothers} />
    </section>
  </div>
</Base>

<style>
  .page { padding-top: var(--sp-6); }
  .page-title {
    font-size: var(--fs-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    border-bottom: var(--rule-strong);
    padding-bottom: var(--sp-3);
  }
  .section-title { margin-top: var(--sp-6); }
</style>
