---
import Base from '../layouts/Base.astro';
import Gear from '../components/Gear.astro';
import GearCrest from '../components/GearCrest.astro';
import { withBase } from '../lib/paths';

// Pillar copy is verbatim from content/about.md — do not edit here without
// editing the source file to match.
const pillars = [
  {
    name: 'Service',
    copy: 'We are known for our service to our college, university, and the larger community. Our service projects create a unifying environment for learning and personal growth for our members.',
  },
  {
    name: 'Profession',
    copy: 'We develop and nurture engineers with strong communication, problem-solving, collaboration, and leadership skills that we demonstrate in our profession, our community, and in our lives.',
  },
  {
    name: 'Brotherhood',
    copy: 'We forge lifelong bonds of fraternal friendship, a journey that develops and delivers a network of lasting personal and professional relationships. We foster an inviting, safe, and social environment in which our members become lifelong friends.',
  },
];

// Every figure below is drawn from the chapter's own content or data — the
// roster file, about.md, and the company list already on /about. Nothing here
// is estimated.
const yearsOnCampus = new Date().getFullYear() - 1988;
const stats = [
  { to: 290, suffix: '+', label: 'Brothers initiated at Omicron Beta' },
  { to: yearsOnCampus, suffix: '', label: 'Years on campus since 1988' },
  { to: 40, suffix: '+', label: 'Companies in the alumni network' },
  { to: 40000, suffix: '+', label: 'Initiated nationally since 1904' },
];
---
<Base
  title="Theta Tau — Omicron Beta | UM-Dearborn"
  description="The Omicron Beta chapter of Theta Tau, the co-ed professional engineering fraternity at the University of Michigan-Dearborn. Founded 1988."
>
  <section class="hero">
    <img
      class="hero-bg"
      src={withBase('/img/chapter-hero.webp')}
      alt=""
      width="1290"
      height="954"
      fetchpriority="high"
    />
    <div class="hero-tint" aria-hidden="true"></div>
    <div class="hero-dim" aria-hidden="true"></div>
    <div class="hero-inner">
      <h1 class="wordmark">Theta&nbsp;Tau</h1>
      <p class="hero-line hero-line-1">
        <span class="visually-hidden">Professional Engineering Fraternity · Omicron Beta Chapter</span>
        <span class="type" data-type-order="0" aria-hidden="true">Professional Engineering Fraternity · Omicron Beta Chapter</span>
      </p>
      <p class="hero-line hero-line-2">
        <span class="visually-hidden">University of Michigan-Dearborn · Founded 1988</span>
        <span class="type" data-type-order="1" aria-hidden="true">University of Michigan-Dearborn · Founded 1988</span>
      </p>
    </div>
    <div class="hero-gear" id="hero-gear" aria-hidden="true">
      <GearCrest class="hero-gear-svg" />
      <span class="gear-hint">Hold to drag</span>
    </div>
  </section>

  <section class="closer on-dark">
    <div class="closer-inner">
      <div class="closer-text">
        <p class="closer-line">
          Theta Tau is a Co-Ed Professional Engineering Fraternity.
        </p>
        <a class="btn btn-outline" href={withBase('/rush/')}>Rush Fall 2026</a>
      </div>
      <dl class="stats">
        {stats.map((st, i) => (
          <div class="stat" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <dt class="stat-num">
              <span data-count-to={st.to}>0</span>{st.suffix}
            </dt>
            <dd class="stat-label">{st.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="chapter" aria-labelledby="chapter-title">
    <div class="chapter-inner">
      <div class="chapter-text" data-reveal>
        <h2 id="chapter-title" class="chapter-title">
          First on campus. <em>Founded 1988.</em>
        </h2>
        <p class="chapter-lead">
          Our Omicron Beta chapter was founded at the University of
          Michigan-Dearborn on January 16th, 1988, making it the first
          professional fraternity on campus and spurring the growth of Greek
          Life at UM-Dearborn.
        </p>
        <p>
          Since its founding, the chapter has initiated over 290 members and has
          become a prominent presence on campus, holding campus leadership
          positions such as Dearborn Campus Engineers, Association for Computing
          Machinery, InterFraternity Council, Student Government, Student
          Activities Board, and SAE racing teams.
        </p>
        <a class="btn btn-outline" href={withBase('/about/')}>Read the chapter history</a>
      </div>

      <div class="crest" data-reveal>
        <div class="crest-plate">
          <span class="crest-big">Ο Β</span>
          <span class="crest-label">Omicron Beta</span>
          <span class="crest-divider"></span>
          <span class="crest-founded">January 16, 1988</span>
        </div>
      </div>
    </div>
  </section>

  <section class="pillars" id="pillars" aria-label="The three pillars">
    {pillars.map((p, i) => (
      <article class={`band ${i % 2 === 1 ? 'band-flip' : ''}`}>
        <div class="band-photo">
          <div class="photo-frame">
            <span>Photograph to come — {p.name}</span>
          </div>
        </div>
        <div class="band-text" data-reveal>
          <h2 class="pillar-name">{p.name}</h2>
          <p>{p.copy}</p>
        </div>
      </article>
    ))}
    <div class="scroll-gear" id="scroll-gear" aria-hidden="true">
      <span class="scroll-gear-tick"></span>
      <Gear class="scroll-gear-svg" />
    </div>
  </section>

</Base>

<style>
  /* --- Hero ------------------------------------------------------- */
  .hero {
    position: relative;
    --hero-gear-size: clamp(14rem, 34vmin, 26rem);
    min-height: calc(100svh - 3.5rem);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--tt-garnet-dk);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-tint {
    position: absolute;
    inset: 0;
    background: var(--tt-garnet);
    mix-blend-mode: multiply;
    opacity: 0.38;
  }
  .hero-dim {
    position: absolute;
    inset: 0;
    background: var(--tt-black);
    opacity: 0.28;
  }
  .hero-inner {
    position: relative;
    max-width: var(--container);
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
    container-type: inline-size;
  }
  /* From 48rem the gear sits centre-right, over the text column, so the column
     has to give way to it; below 48rem the gear drops to the foot of the hero
     and the text gets the full width back. */
  @media (min-width: 48rem) {
    /* Reserve only the slice of the gear that actually crosses into the text
       column. The gear is positioned against the viewport while the column is
       capped at --container and centred, so on a wide screen most of the gear
       sits out in the margin; reserving its full width threw away ~200px and
       forced the identity line to wrap. */
    .hero-inner {
      padding-right: max(
        var(--gutter),
        calc(
          0.94 * var(--hero-gear-size)
          - max(0px, (100vw - var(--container)) / 2)
          + var(--sp-4)
        )
      );
    }
    /* If the column ever is too narrow for one line, break it evenly rather
       than orphaning the last word. */
    .hero-line { text-wrap: balance; }
  }
  .wordmark {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: var(--fs-wordmark);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    max-width: 9ch;
    color: var(--tt-white);
  }
  .hero-line {
    font-family: var(--font-head);
    text-transform: uppercase;
    color: var(--tt-white);
    /* Identity, not prose — the global 65ch measure must not cap it. */
    max-width: none;
    /* Room for the bar's own vertical padding, plus a hairline of daylight
       between bars on the rare width where a line does wrap. */
    line-height: 2.15;
  }
  /* The bar is painted on the run of text, not on the paragraph, so it
     shrink-wraps to the words; box-decoration-break gives each line its own
     tight bar instead of one ragged full-width block. */
  .hero-line .type {
    display: inline;
    padding: 0.4em 0.75em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .hero-line-1 .type { background: var(--tt-garnet); }
  .hero-line-2 .type { background: var(--tt-black); }
  .hero-line-1 {
    margin-top: var(--sp-4);
    font-size: clamp(0.8125rem, 2.2vw, 1.0625rem);
    /* The identity string measures 44.6em at this tracking, so size it against
       the text column and it stays on one line; the floor stops it shrinking
       past legible, and below that it wraps into two bars. Declared after the
       vw fallback so a browser without container queries keeps that one. */
    font-size: clamp(0.8125rem, 100cqi / 45, 1.0625rem);
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  .hero-line-2 {
    margin-top: 0.375rem;
    font-size: clamp(0.75rem, 1.8vw, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--tt-white);
  }
  .hero-gear {
    position: absolute;
    right: calc(-0.06 * var(--hero-gear-size));
    top: 50%;
    margin-top: calc(-0.5 * var(--hero-gear-size));
    width: var(--hero-gear-size);
    height: var(--hero-gear-size);
    container-type: inline-size;
    cursor: grab;
    touch-action: none;
    /* Dragging across the gear would otherwise start a text selection and
       flash the blue highlight over the hero. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .hero-gear.dragging { cursor: grabbing; }
  /* Only shown once the drag handler is actually wired up, so the hint never
     promises behaviour the page cannot deliver. */
  .gear-hint {
    display: none;
    position: absolute;
    top: calc(100% + 0.625rem);
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-head);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tt-white);
    pointer-events: none;
  }
  .hero-gear.interactive .gear-hint { display: block; }
  @media (max-width: 47.9375rem) {
    .hero-gear.interactive .gear-hint { display: none; }
  }
  .hero-gear:focus-visible { outline-color: var(--tt-white); }
  /* Focus moved by pointer still matches :focus-visible here, which drew a
     white box round the gear on every grab. Keyboard focus keeps its ring. */
  .hero-gear.pointer-focus:focus-visible { outline: none; }
  .hero-gear-svg { width: 100%; height: 100%; }
  @media (max-width: 47.9375rem) {
    .hero { align-items: flex-start; padding-top: var(--sp-6); }
    .hero-gear {
      top: auto;
      bottom: calc(-0.08 * var(--hero-gear-size));
      margin-top: 0;
    }
  }

  /* --- Pillars ---------------------------------------------------- */
  .pillars { position: relative; }
  .band {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 88svh;
    border-top: var(--rule-hairline);
  }
  .band-photo { display: grid; }
  .band-photo .photo-frame { border-block: none; min-height: 20rem; }
  .band:not(.band-flip) .band-photo .photo-frame { border-left: none; }
  .band-flip .band-photo .photo-frame { border-right: none; }
  .band-text {
    align-self: center;
    padding: var(--sp-7) var(--gutter);
  }
  .band-flip .band-photo { order: 2; }
  .band-flip .band-text { justify-self: end; }
  .pillar-name {
    font-size: var(--fs-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: var(--lh-tight);
  }
  .band-text p {
    margin-top: var(--sp-4);
    max-width: 34rem;
  }
  @media (max-width: 47.9375rem) {
    .band { grid-template-columns: 1fr; min-height: 0; }
    .band-flip .band-photo { order: 0; }
    .band-text { padding: var(--sp-5) var(--gutter) var(--sp-6); }
    .band-photo .photo-frame { min-height: 14rem; }
  }

  /* --- Scroll gear — a dial that reads scroll progress ------------ */
  .scroll-gear {
    position: fixed;
    left: 0.75rem;
    top: 50%;
    width: 4rem;
    height: 4rem;
    margin-top: -2rem;
    color: var(--tt-black);
    visibility: hidden;
  }
  .scroll-gear.live { visibility: visible; }
  .scroll-gear-tick {
    position: absolute;
    left: 50%;
    top: -0.5rem;
    width: 2px;
    height: 0.375rem;
    margin-left: -1px;
    background: var(--tt-garnet);
  }
  .scroll-gear-svg { width: 100%; height: 100%; }
  @media (max-width: 47.9375rem) {
    .scroll-gear { display: none; }
  }

  /* The last pillar band runs flush into the footer */
  :global(.site-footer) { margin-top: 0; }

  /* --- Chapter panel (experiment/heraldic) ------------------------- */
  .chapter {
    border-block: var(--rule-hairline);
  }
  .chapter-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--sp-7) var(--gutter);
    display: grid;
    gap: var(--sp-5);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .chapter-inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--sp-7);
    }
  }
  .chapter-title {
    font-family: var(--font-head);
    /* Below --fs-display: this is a section head, not a page title, and at
       display size it wrapped to four lines and swamped the crest. */
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0 0 var(--sp-3);
    color: var(--tt-black);
  }
  /* The italic serif clause is the whole device: one voice states the fact,
     the other inflects it. Costs nothing, and the fonts are already loaded. */
  .chapter-title em {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    color: var(--tt-garnet);
    letter-spacing: 0;
  }
  .chapter-text p {
    max-width: var(--measure);
    margin: 0 0 var(--sp-3);
  }
  .chapter-lead::first-letter {
    float: left;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 3.6em;
    line-height: 0.82;
    margin: 0.06em 0.12em 0 0;
    color: var(--tt-garnet);
  }
  .chapter-text .btn { margin-top: var(--sp-2); }

  .crest-plate {
    aspect-ratio: 4 / 5;
    background: var(--tt-garnet);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--tt-paper);
    container-type: inline-size;
  }
  .crest-big {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(3.5rem, 26cqi, 8rem);
    line-height: 0.85;
    letter-spacing: 0.02em;
  }
  .crest-label {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(0.75rem, 3.4cqi, 1.0625rem);
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    text-transform: uppercase;
    margin-top: var(--sp-2);
  }
  .crest-divider {
    width: 3.75rem;
    height: 2px;
    background: var(--tt-gold);
    margin: var(--sp-3) 0;
  }
  .crest-founded {
    font-family: var(--font-head);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    color: var(--tt-gold);
  }

  /* --- Closer band ------------------------------------------------ */
  .closer { background: var(--tt-garnet); }
  .closer-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--sp-6) var(--gutter);
    display: grid;
    gap: var(--sp-5);
  }
  @media (min-width: 56rem) {
    .closer-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--sp-7);
      align-items: center;
    }
  }
  .closer-line {
    color: var(--tt-white);
    font-size: clamp(1.375rem, 3vw, 2rem);
    font-weight: 600;
    max-width: 22ch;
    margin-bottom: var(--sp-4);
  }

  /* Counting figures — every number is drawn from chapter content */
  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(201, 165, 92, 0.42);
    border: 1px solid rgba(201, 165, 92, 0.42);
  }
  .stat {
    background: var(--tt-garnet-deep);
    padding: var(--sp-3) var(--sp-3) var(--sp-4);
  }
  .stat-num {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1;
    color: var(--tt-gold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .stat-label {
    margin: var(--sp-1) 0 0;
    font-family: var(--font-head);
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.03em;
    color: var(--tt-white);
    text-transform: uppercase;
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Hero identity lines type themselves in, one after the other. The full
     text is already in the DOM for assistive tech; these spans are the
     visual copy only. */
  const typed = Array.from(
    document.querySelectorAll<HTMLElement>('.hero-line .type')
  ).sort((a, b) => Number(a.dataset.typeOrder) - Number(b.dataset.typeOrder));

  if (typed.length && !reduced) {
    const SPEED = 26; // ms per character
    const texts = typed.map((el) => el.textContent ?? '');
    typed.forEach((el) => { el.textContent = ''; });

    const typeOne = (i: number) => {
      if (i >= typed.length) return;
      const el = typed[i];
      const text = texts[i];
      el.classList.add('type-caret');
      let n = 0;
      const step = () => {
        el.textContent = text.slice(0, ++n);
        if (n < text.length) {
          window.setTimeout(step, SPEED);
        } else {
          el.classList.remove('type-caret');
          window.setTimeout(() => typeOne(i + 1), 260);
        }
      };
      window.setTimeout(step, i === 0 ? 420 : 0);
    };
    typeOne(0);
  }

  /* Draggable hero gear — grab, spin, momentum, friction. */
  const gear = document.getElementById('hero-gear');
  if (gear && !reduced) {
    const svg = gear.querySelector('svg')!;
    gear.classList.add('interactive');
    gear.removeAttribute('aria-hidden');
    gear.setAttribute('role', 'img');
    gear.setAttribute('tabindex', '0');
    gear.setAttribute(
      'aria-label',
      'The chapter gear. Drag it, or press the left and right arrow keys, to spin it.'
    );
    // A slow constant turn is the affordance: a still gear reads as a
    // graphic, a turning one invites the grab.
    const IDLE = 0.2;   // rad/s, ~31s per revolution
    let angle = 0;      // radians
    let vel = IDLE;     // rad/s
    let dragging = false;
    let lastPointerAngle = 0;
    let lastMoveTime = 0;
    let lastFrame = 0;

    const pointerAngle = (e: PointerEvent) => {
      const r = gear.getBoundingClientRect();
      return Math.atan2(
        e.clientY - (r.top + r.height / 2),
        e.clientX - (r.left + r.width / 2)
      );
    };
    const norm = (a: number) =>
      ((a + Math.PI) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI) - Math.PI;

    gear.addEventListener('pointerdown', (e) => {
      // preventDefault stops the selection, but also suppresses the focus a
      // click would normally give — restore it so the arrow keys still work.
      e.preventDefault();
      gear.classList.add('pointer-focus');
      gear.focus();
      dragging = true;
      gear.classList.add('dragging');
      gear.setPointerCapture(e.pointerId);
      lastPointerAngle = pointerAngle(e);
      lastMoveTime = performance.now();
      vel = 0;
    });
    gear.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const now = performance.now();
      const a = pointerAngle(e);
      const d = norm(a - lastPointerAngle);
      angle += d;
      const dt = (now - lastMoveTime) / 1000;
      if (dt > 0) vel = d / dt;
      lastPointerAngle = a;
      lastMoveTime = now;
      svg.style.transform = `rotate(${angle}rad)`;
    });
    const release = () => {
      dragging = false;
      gear.classList.remove('dragging');
    };
    gear.addEventListener('pointerup', release);
    gear.addEventListener('pointercancel', release);
    gear.addEventListener('blur', () => gear.classList.remove('pointer-focus'));
    gear.addEventListener('keydown', (e) => {
      // Any key means the keyboard is in use — let the ring come back.
      gear.classList.remove('pointer-focus');
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      vel = Math.max(-12, Math.min(12, vel + (e.key === 'ArrowRight' ? 2.5 : -2.5)));
    });

    const spin = (t: number) => {
      const dt = lastFrame ? (t - lastFrame) / 1000 : 0;
      lastFrame = t;
      if (!dragging && dt > 0) {
        angle += vel * dt;
        // Friction settles toward the idle turn rather than to a dead stop,
        // so a flick decays back into the resting drift.
        vel += (IDLE - vel) * (1 - Math.exp(-1.4 * dt));
        svg.style.transform = `rotate(${angle}rad)`;
      }
      requestAnimationFrame(spin);
    };
    requestAnimationFrame(spin);
  }

  /* Scroll gear — one third of a turn per pillar. */
  const dial = document.getElementById('scroll-gear');
  const pillarsEl = document.getElementById('pillars');
  if (dial && pillarsEl) {
    const dialSvg = dial.querySelector('svg')!;
    const io = new IntersectionObserver(
      ([entry]) => dial.classList.toggle('live', entry.isIntersecting),
      { rootMargin: '-15% 0px -15% 0px' }
    );
    io.observe(pillarsEl);

    if (!reduced) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = pillarsEl.getBoundingClientRect();
        const vh = window.innerHeight;
        const total = rect.height - vh;
        const p = Math.min(1, Math.max(0, -rect.top / (total > 0 ? total : 1)));
        dialSvg.style.transform = `rotate(${p * 360}deg)`;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      update();
    }
  }
</script>
